<Window x:Class="PerfOverlay.ConfigurationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PERF OVERLAY SETTINGS" Width="480" Height="680" MinHeight="680" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" FontFamily="pack://application:,,,/PerfOverlay;component/Assets/Fonts/fusion-pixel-8px-monospaced-latin.ttf#Fusion Pixel 8px Mono latin">
 <Border Background="#E8E4D8" BorderBrush="#172124" BorderThickness="3">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Background="#C9C5B9" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
    <TextBlock Text="PERF OVERLAY SETTINGS" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="14"/>
    <Button Grid.Column="1" Content="X" Click="Close_Click" BorderThickness="0" Background="Transparent" FontSize="16"/>
   </Grid>
   <Grid Grid.Row="1" Margin="18">
    <Grid.Resources>
     <Style x:Key="PixelScrollButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Background" Value="#C9C5B9"/>
      <Setter Property="Foreground" Value="#172124"/>
      <Setter Property="BorderBrush" Value="#172124"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontFamily" Value="pack://application:,,,/PerfOverlay;component/Assets/Fonts/fusion-pixel-8px-monospaced-latin.ttf#Fusion Pixel 8px Mono latin"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Template">
       <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
         <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
         </Border>
         <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#B9D8E5"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#91BFD0"/></Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate>
       </Setter.Value>
      </Setter>
     </Style>
     <Style x:Key="PixelScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
       <Setter.Value>
        <ControlTemplate TargetType="Thumb">
         <Border x:Name="ThumbSurface" Background="#8F8B80" BorderBrush="#172124" BorderThickness="2" SnapsToDevicePixels="True">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
           <Rectangle Width="8" Height="2" Fill="#172124" Margin="0,1"/>
           <Rectangle Width="8" Height="2" Fill="#172124" Margin="0,1"/>
           <Rectangle Width="8" Height="2" Fill="#172124" Margin="0,1"/>
          </StackPanel>
         </Border>
         <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#B9D8E5"/></Trigger>
          <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#91BFD0"/></Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate>
       </Setter.Value>
      </Setter>
     </Style>
     <Style x:Key="PixelScrollPageButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
     </Style>
     <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="18"/>
      <Setter Property="MinWidth" Value="18"/>
      <Setter Property="Background" Value="#C9C5B9"/>
      <Setter Property="Template">
       <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
         <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
          <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="18"/></Grid.RowDefinitions>
          <RepeatButton Grid.Row="0" Command="{x:Static ScrollBar.LineUpCommand}" Content="^" Style="{StaticResource PixelScrollButton}" BorderThickness="0,0,0,2"/>
          <Track x:Name="PART_Track" Grid.Row="1" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
           <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource PixelScrollPageButton}"/></Track.DecreaseRepeatButton>
           <Track.Thumb><Thumb MinHeight="24" Style="{StaticResource PixelScrollThumb}"/></Track.Thumb>
           <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource PixelScrollPageButton}"/></Track.IncreaseRepeatButton>
          </Track>
          <RepeatButton Grid.Row="2" Command="{x:Static ScrollBar.LineDownCommand}" Content="v" Style="{StaticResource PixelScrollButton}" BorderThickness="0,2,0,0"/>
          <Border Panel.ZIndex="5" Background="Transparent" BorderBrush="#172124" BorderThickness="2" IsHitTestVisible="False" SnapsToDevicePixels="True"/>
         </Grid>
        </ControlTemplate>
       </Setter.Value>
      </Setter>
     </Style>
     <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="pack://application:,,,/PerfOverlay;component/Assets/Fonts/fusion-pixel-8px-monospaced-latin.ttf#Fusion Pixel 8px Mono latin"/><Setter Property="FontSize" Value="16"/><Setter Property="Foreground" Value="#172124"/></Style>
     <Style TargetType="ComboBox">
      <Setter Property="FontFamily" Value="pack://application:,,,/PerfOverlay;component/Assets/Fonts/fusion-pixel-8px-monospaced-latin.ttf#Fusion Pixel 8px Mono latin"/><Setter Property="FontSize" Value="15"/><Setter Property="Foreground" Value="#172124"/><Setter Property="Height" Value="36"/><Setter Property="Margin" Value="0,6,0,12"/><Setter Property="Background" Value="#D5D0C3"/><Setter Property="BorderBrush" Value="#172124"/><Setter Property="BorderThickness" Value="2"/><Setter Property="Padding" Value="8,0"/><Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="FontFamily" Value="pack://application:,,,/PerfOverlay;component/Assets/Fonts/fusion-pixel-8px-monospaced-latin.ttf#Fusion Pixel 8px Mono latin"/><Setter Property="FontSize" Value="15"/><Setter Property="Foreground" Value="#172124"/><Setter Property="Background" Value="#D5D0C3"/><Setter Property="Height" Value="34"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="8,0"/></Style></Setter.Value></Setter>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid SnapsToDevicePixels="True"><Border x:Name="Frame" Background="#D5D0C3" BorderBrush="#172124" BorderThickness="2"/><ToggleButton x:Name="DropButton" Background="Transparent" BorderThickness="0" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/><Viewbox Width="15" Height="9" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"><Polyline Points="0,0 3,0 3,3 6,3 6,6 9,6 9,3 12,3 12,0 15,0" Stroke="#172124" StrokeThickness="2" StrokeLineJoin="Miter" StrokeStartLineCap="Square" StrokeEndLineCap="Square" RenderOptions.EdgeMode="Aliased"/></Viewbox><Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="False" Focusable="False" PopupAnimation="None"><Border Background="#D5D0C3" BorderBrush="#172124" BorderThickness="2"><ScrollViewer MaxHeight="260" CanContentScroll="True"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#E8E4D8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
     </Style>
     <Style TargetType="TextBox"><Setter Property="FontFamily" Value="pack://application:,,,/PerfOverlay;component/Assets/Fonts/fusion-pixel-8px-monospaced-latin.ttf#Fusion Pixel 8px Mono latin"/><Setter Property="FontSize" Value="15"/><Setter Property="Foreground" Value="#172124"/><Setter Property="Background" Value="#F5F2E9"/><Setter Property="BorderBrush" Value="#172124"/><Setter Property="BorderThickness" Value="2"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="6,0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
     <Style TargetType="Button"><Setter Property="FontFamily" Value="pack://application:,,,/PerfOverlay;component/Assets/Fonts/fusion-pixel-8px-monospaced-latin.ttf#Fusion Pixel 8px Mono latin"/><Setter Property="FontSize" Value="15"/><Setter Property="Foreground" Value="#172124"/><Setter Property="Background" Value="#D5D0C3"/><Setter Property="BorderBrush" Value="#172124"/><Setter Property="BorderThickness" Value="2"/></Style>
     <Style TargetType="ToggleButton">
      <Setter Property="FontFamily" Value="pack://application:,,,/PerfOverlay;component/Assets/Fonts/fusion-pixel-8px-monospaced-latin.ttf#Fusion Pixel 8px Mono latin"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Foreground" Value="#172124"/>
      <Setter Property="Background" Value="#D5D0C3"/>
      <Setter Property="BorderBrush" Value="#172124"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="Template">
       <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
         <Grid SnapsToDevicePixels="True">
          <Border x:Name="ToggleSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
          <ContentPresenter Margin="8,0" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
          <Border x:Name="SelectedMarker" Width="7" Height="7" Margin="4" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#172124" Visibility="Collapsed" IsHitTestVisible="False"/>
         </Grid>
         <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
           <Setter TargetName="ToggleSurface" Property="Background" Value="#B9D8E5"/>
          </Trigger>
          <Trigger Property="IsChecked" Value="True">
           <Setter TargetName="ToggleSurface" Property="Background" Value="#91BFD0"/>
           <Setter TargetName="ToggleSurface" Property="BorderThickness" Value="3"/>
           <Setter TargetName="SelectedMarker" Property="Visibility" Value="Visible"/>
          </Trigger>
          <MultiTrigger>
           <MultiTrigger.Conditions>
            <Condition Property="IsChecked" Value="True"/>
            <Condition Property="IsMouseOver" Value="True"/>
           </MultiTrigger.Conditions>
           <Setter TargetName="ToggleSurface" Property="Background" Value="#6F9EAF"/>
          </MultiTrigger>
          <Trigger Property="IsPressed" Value="True">
           <Setter TargetName="ToggleSurface" Property="Background" Value="#769EAA"/>
          </Trigger>
          <MultiTrigger>
           <MultiTrigger.Conditions>
            <Condition Property="IsChecked" Value="True"/>
            <Condition Property="IsPressed" Value="True"/>
           </MultiTrigger.Conditions>
           <Setter TargetName="ToggleSurface" Property="Background" Value="#567E8C"/>
          </MultiTrigger>
         </ControlTemplate.Triggers>
        </ControlTemplate>
       </Setter.Value>
      </Setter>
     </Style>
    </Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <TextBlock Text="DISPLAY" FontSize="18" Margin="0,0,0,4"/>
     <ComboBox x:Name="MonitorSelector" DisplayMemberPath="DisplayName"/>
    </StackPanel>
    <StackPanel Grid.Row="1">
     <TextBlock Text="OVERLAY POSITION" FontSize="18" Margin="0,0,0,4"/>
     <UniformGrid x:Name="PositionPresetGrid" Columns="3" Rows="3" Margin="0,4,0,6">
      <ToggleButton Content="TOP LEFT" Tag="TopLeft" Height="30" Click="PositionPreset_Click"/><ToggleButton Content="TOP CENTER" Tag="TopCenter" Height="30" Click="PositionPreset_Click" Margin="4,0"/><ToggleButton Content="TOP RIGHT" Tag="TopRight" Height="30" Click="PositionPreset_Click"/>
      <ToggleButton Content="MID LEFT" Tag="MiddleLeft" Height="30" Click="PositionPreset_Click" Margin="0,4,0,0"/><Border Margin="4,4,4,0"/><ToggleButton Content="MID RIGHT" Tag="MiddleRight" Height="30" Click="PositionPreset_Click" Margin="0,4,0,0"/>
      <ToggleButton Content="BOT LEFT" Tag="BottomLeft" Height="30" Click="PositionPreset_Click" Margin="0,4,0,0"/><ToggleButton Content="BOT CENTER" Tag="BottomCenter" Height="30" Click="PositionPreset_Click" Margin="4,4,4,0"/><ToggleButton Content="BOT RIGHT" Tag="BottomRight" Height="30" Click="PositionPreset_Click" Margin="0,4,0,0"/>
     </UniformGrid>
     <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="X OFFSET" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="OffsetXBox" Grid.Column="1"/>
      <TextBlock Text="Y OFFSET" Grid.Column="2" VerticalAlignment="Center" Margin="16,0,8,0"/><TextBox x:Name="OffsetYBox" Grid.Column="3"/>
     </Grid>
    </StackPanel>
    <StackPanel Grid.Row="2">
     <TextBlock Text="LAYOUT" FontSize="18" Margin="0,0,0,4"/>
     <ComboBox x:Name="LayoutSelector"><ComboBoxItem Content="HORIZONTAL"/><ComboBoxItem Content="VERTICAL"/></ComboBox>
    </StackPanel>
    <StackPanel Grid.Row="3">
     <TextBlock Text="TEXT COLOR" FontSize="18" Margin="0,0,0,4"/>
     <ComboBox x:Name="TextColorSelector">
      <ComboBoxItem Content="AUTO" Tag="Auto"/>
      <ComboBoxItem Content="WHITE" Tag="White"/>
      <ComboBoxItem Content="BLACK" Tag="Black"/>
     </ComboBox>
    </StackPanel>
    <Grid x:Name="SettingsPages" Grid.Row="4" Margin="0,6,0,0">
     <StackPanel x:Name="MainPage" VerticalAlignment="Top">
      <Button Content="SHORTCUT SETTINGS  >" Height="48" Margin="0,0,0,10" Click="OpenHotkeysPage_Click"/>
      <Button Content="OVERLAY DATA  >" Height="48" Click="OpenDataPage_Click"/>
     </StackPanel>
     <ScrollViewer x:Name="HotkeysPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,8,0">
       <Button Content="&lt; BACK" Height="36" HorizontalAlignment="Left" Width="110" Margin="0,0,0,12" Click="BackToMainPage_Click"/>
       <TextBlock Text="SHORTCUT SETTINGS" FontSize="18" Margin="0,0,0,10"/>
       <TextBlock Text="SETTINGS WINDOW" FontSize="14" Margin="0,0,0,5"/>
       <TextBox x:Name="ConfigurationHotKeyBox" IsReadOnly="True" Focusable="True" PreviewKeyDown="ConfigurationHotKeyBox_PreviewKeyDown" Height="36" Margin="0,0,0,5"/>
       <TextBlock x:Name="ConfigurationHotKeyHint" Text="CLICK FIELD AND PRESS SHORTCUT" FontSize="10" Margin="0,0,0,12"/>
       <TextBlock Text="OVERLAY VISIBILITY" FontSize="14" Margin="0,0,0,5"/>
       <TextBox x:Name="OverlayHotKeyBox" IsReadOnly="True" Focusable="True" PreviewKeyDown="OverlayHotKeyBox_PreviewKeyDown" Height="36" Margin="0,0,0,5"/>
       <TextBlock x:Name="OverlayHotKeyHint" Text="CLICK FIELD AND PRESS SHORTCUT" FontSize="10" Margin="0,0,0,12"/>
      </StackPanel>
     </ScrollViewer>
     <ScrollViewer x:Name="DataPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,8,0">
       <Button Content="&lt; BACK" Height="36" HorizontalAlignment="Left" Width="110" Margin="0,0,0,12" Click="BackToMainPage_Click"/>
       <TextBlock Text="OVERLAY DATA" FontSize="18" Margin="0,0,0,8"/>
       <UniformGrid Columns="2" Rows="4" Margin="0,0,0,10">
        <ToggleButton x:Name="ShowFpsToggle" Content="FPS" Height="34" Margin="0,0,6,5"/>
        <ToggleButton x:Name="ShowBaseFpsToggle" Content="BASE FPS" Height="34" Margin="0,0,0,5"/>
        <ToggleButton x:Name="ShowLowToggle" Content="1% LOW" Height="34" Margin="0,0,6,5"/>
        <ToggleButton x:Name="ShowGpuToggle" Content="GPU" Height="34" Margin="0,0,0,5"/>
        <ToggleButton x:Name="ShowCpuToggle" Content="CPU" Height="34" Margin="0,0,6,5"/>
        <ToggleButton x:Name="ShowMemoryToggle" Content="MEMORY" Height="34" Margin="0,0,0,5"/>
        <ToggleButton x:Name="ShowLatencyToggle" Content="LATENCY" Height="34" Margin="0,0,6,5"/>
       </UniformGrid>
       <TextBlock Text="FPS VALUES" FontSize="16" Margin="0,5,0,4"/>
       <TextBlock Text="FPS: DISPLAYED FRAME RATE" FontSize="12" Margin="0,0,0,3"/>
       <TextBlock Text="BASE: GAME RENDER RATE" FontSize="12" Margin="0,0,0,3"/>
       <TextBlock Text="1% LOW: SLOWEST 1% AVG (30S)" FontSize="12" Margin="0,0,0,10"/>
       <TextBlock Text="GPU MODELS" FontSize="16" Margin="0,0,0,4"/>
       <StackPanel x:Name="GpuInfoPanel"/>
      </StackPanel>
     </ScrollViewer>
    </Grid>
    <Grid Grid.Row="5" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button Content="EXIT APP" Width="112" Height="42" HorizontalAlignment="Left" Click="Exit_Click"/>
     <Button Grid.Column="1" Content="APPLY" Width="104" Height="42" Click="Apply_Click"/>
    </Grid>
   </Grid>
  </Grid>
 </Border>
</Window>
